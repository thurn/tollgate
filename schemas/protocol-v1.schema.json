{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tollgate.dev/schema/protocol-v1.json",
  "title": "Tollgate IPC v1 control payloads",
  "oneOf": [
    { "$ref": "#/$defs/handshake" },
    { "$ref": "#/$defs/handshakeAck" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "handshake": {
      "type": "object", "additionalProperties": false,
      "required": ["client_instance_id", "client_version", "protocol_min", "protocol_max", "schema_version", "max_control_payload", "max_log_payload", "supported_frame_kinds"],
      "properties": {
        "client_instance_id": { "$ref": "#/$defs/uuid" },
        "client_version": { "type": "string" }, "protocol_min": { "type": "integer" }, "protocol_max": { "type": "integer" },
        "schema_version": { "type": "integer" }, "max_control_payload": { "type": "integer", "maximum": 8388608 },
        "max_log_payload": { "type": "integer", "maximum": 1048576 }, "supported_frame_kinds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "handshakeAck": {
      "type": "object", "additionalProperties": false,
      "required": ["app_version", "selected_protocol", "schema_version", "max_control_payload", "max_log_payload", "supported_frame_kinds"],
      "properties": {
        "app_version": { "type": "string" }, "selected_protocol": { "type": "integer" },
        "schema_version": { "type": "integer" }, "max_control_payload": { "type": "integer", "maximum": 8388608 },
        "max_log_payload": { "type": "integer", "maximum": 1048576 }, "supported_frame_kinds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false, "required": ["command"],
      "properties": {
        "command": { "enum": ["snapshot", "item-status", "initialize", "candidate", "approve", "authorize-candidate", "check", "cancel", "retry", "reorder", "pull", "push", "reconcile", "update", "worktree-create", "worktree-remove", "reset-slot", "snapshot-cache", "purge-cache", "artifact-pin", "artifact-prune", "remove-repository", "apply-configuration", "validate-configuration", "regenerate-configuration", "logs", "doctor", "pause", "resume", "reload-environment"] },
        "repository_id": { "$ref": "#/$defs/uuid" },
        "item_id": { "$ref": "#/$defs/uuid" },
        "buildset_id": { "$ref": "#/$defs/uuid" },
        "slot_id": { "$ref": "#/$defs/uuid" },
        "artifact_id": { "type": "string", "format": "uuid" },
        "selected_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "command_id": { "$ref": "#/$defs/uuid" },
        "path": { "type": "string" },
        "run": { "type": ["string", "null"] },
        "bootstrap": { "type": "boolean" },
        "detach_master": { "type": "boolean" },
        "revision": { "type": "string" },
        "worktree_path": { "type": ["string", "null"] },
        "branch": { "type": "string" },
        "destination": { "type": ["string", "null"] },
        "expected_revision": { "type": "integer", "minimum": 0 },
        "expected_queue_revision": { "type": ["integer", "null"], "minimum": 0 },
        "expected_observed_master": { "type": ["object", "null"] },
        "cold": { "type": "boolean" },
        "all_slots": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "step": { "type": ["string", "null"] },
        "start_sequence": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "command": { "const": "item-status" } } }, "then": { "required": ["repository_id", "item_id"] } },
        { "if": { "properties": { "command": { "const": "initialize" } } }, "then": { "required": ["path"] } },
        { "if": { "properties": { "command": { "enum": ["candidate", "approve", "check"] } } }, "then": { "required": ["repository_id", "revision", "command_id"] } },
        { "if": { "properties": { "command": { "const": "authorize-candidate" } } }, "then": { "required": ["repository_id", "item_id", "expected_revision", "command_id"] } },
        { "if": { "properties": { "command": { "const": "cancel" } } }, "then": { "required": ["repository_id", "item_id", "expected_revision", "command_id"] } },
        { "if": { "properties": { "command": { "const": "retry" } } }, "then": { "required": ["repository_id", "item_id", "cold", "command_id"] } },
        { "if": { "properties": { "command": { "const": "reorder" } } }, "then": { "required": ["repository_id", "selected_ids", "expected_revision", "command_id"] } },
        { "if": { "properties": { "command": { "enum": ["pull", "push", "remove-repository", "apply-configuration", "regenerate-configuration", "snapshot-cache", "pause", "resume"] } } }, "then": { "required": ["repository_id", "command_id"] } },
        { "if": { "properties": { "command": { "const": "reconcile" } } }, "then": { "required": ["repository_id", "command_id"] } },
        { "if": { "properties": { "command": { "const": "update" } } }, "then": { "required": ["repository_id", "worktree_path", "command_id"] } },
        { "if": { "properties": { "command": { "const": "worktree-create" } } }, "then": { "required": ["repository_id", "branch", "command_id"] } },
        { "if": { "properties": { "command": { "const": "worktree-remove" } } }, "then": { "required": ["repository_id", "path", "command_id"] } },
        { "if": { "properties": { "command": { "const": "reset-slot" } } }, "then": { "required": ["repository_id", "slot_id", "command_id"] } },
        { "if": { "properties": { "command": { "const": "purge-cache" } } }, "then": { "required": ["repository_id", "all_slots", "command_id"] } },
        { "if": { "properties": { "command": { "const": "artifact-pin" } } }, "then": { "required": ["repository_id", "artifact_id", "pinned", "command_id"] } },
        { "if": { "properties": { "command": { "const": "artifact-prune" } } }, "then": { "required": ["repository_id", "artifact_id", "command_id"] } },
        { "if": { "properties": { "command": { "enum": ["validate-configuration", "doctor"] } } }, "then": { "required": ["repository_id"] } },
        { "if": { "properties": { "command": { "const": "logs" } } }, "then": { "required": ["repository_id", "item_id", "start_sequence"] } },
        { "if": { "properties": { "command": { "const": "reload-environment" } } }, "then": { "required": ["command_id"] } }
      ]
    },
    "response": {
      "type": "object", "additionalProperties": false, "required": ["ok"],
      "properties": { "ok": { "type": "boolean" }, "result": {}, "error": { "type": ["object", "null"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" } } } }
    }
  }
}
